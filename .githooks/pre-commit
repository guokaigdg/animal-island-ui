#!/usr/bin/env sh
#  在 commit 之前自动跑 `npm run ci`
#  失败 → commit 中止 (必须先修问题)
#  紧急绕过 (不推荐) : git commit --no-verify
#  卸载             : git config --unset core.hooksPath
#  重装             : npm run setup:hooks

set -e

#  版权政策: 仓库保持零位图文件(图片一律用 CSS/原创 SVG 替代)
BLOCKED=$(git diff --cached --name-only --diff-filter=ACR | grep -iE '\.(png|jpe?g|webp|gif|ico|bmp|tiff?)$' || true)
if [ -n "$BLOCKED" ]; then
    echo ""
    echo "❌ 检测到位图文件提交(版权整改政策: 本仓库保持零图片):"
    echo "$BLOCKED" | sed 's/^/     /'
    echo "   如需图形, 请使用 CSS 渐变或原创 SVG。"
    echo "   紧急绕过(不推荐): git commit --no-verify"
    echo ""
    exit 1
fi

echo "                                                                                      "
echo "                                                                                      "
echo "  ▄▄▄  ▄▄  ▄▄ ▄▄ ▄▄   ▄▄  ▄▄▄  ▄▄      ▄▄  ▄▄▄▄ ▄▄     ▄▄▄  ▄▄  ▄▄ ▄▄▄▄      ▄▄ ▄▄ ▄▄ "
echo " ██▀██ ███▄██ ██ ██▀▄▀██ ██▀██ ██  ▄▄▄ ██ ███▄▄ ██    ██▀██ ███▄██ ██▀██ ▄▄▄ ██ ██ ██ "
echo " ██▀██ ██ ▀██ ██ ██   ██ ██▀██ ██▄▄▄   ██ ▄▄██▀ ██▄▄▄ ██▀██ ██ ▀██ ████▀     ▀███▀ ██"
echo ""
echo "          ╔══════════════════════════════════════════════════════════════╗"
echo "          ║  pre-commit: running CI (format/check:docs/lint/test/build)  ║"
echo "          ╚══════════════════════════════════════════════════════════════╝"
echo ""

if npm run ci; then
    echo ""
    echo "✅ CI 通过,继续 commit"
    echo ""
    exit 0
else
    CI_EXIT=$?
    echo ""
    echo "❌ CI 失败(exit: $CI_EXIT),commit 已中止"
    echo "   修复上面的错误后再 commit。"
    echo "   紧急绕过(不推荐):git commit --no-verify"
    echo ""
    exit 1
fi
